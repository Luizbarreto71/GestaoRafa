# ===========================================================================
# Controle Rafa Multimarcas
#
# Local:     copie este arquivo para `.env` e preencha a linha abaixo.
# Produção:  cole a mesma linha na Vercel → Settings → Environment Variables.
# ===========================================================================

# --------------------------------------------------------------------------
# ÚNICA VARIÁVEL OBRIGATÓRIA
#
# É só trocar [YOUR-PASSWORD] pela senha do banco (a que você criou junto
# com o projeto no Supabase).
#
# Se precisar pegar de novo: Supabase → botão "Connect" no topo → aba "ORMs"
# → Prisma. Use a URL do **Session pooler**, que termina em `:5432/postgres`.
# Ela serve tanto para o sistema rodar quanto para criar as tabelas.
# --------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-us-east-2.pooler.supabase.com:5432/postgres"


# ===========================================================================
# Daqui para baixo é tudo opcional — o sistema funciona sem preencher nada.
# ===========================================================================

# Login do administrador criado por `npm run db:seed`.
# Deixando em branco, vale admin@rafamultimarcas.com / admin123.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Chave que assina os logins. Sem definir, o sistema gera uma sozinho na
# primeira execução e guarda no banco. Só mexa se quiser controlá-la —
# trocar o valor desconecta todo mundo.
# JWT_SECRET=

# --------------------------------------------------------------------------
# Mandar cada movimentação para uma planilha do Google (opcional)
#
# 1. console.cloud.google.com → novo projeto → ative a "Google Sheets API"
# 2. Crie uma Conta de serviço e gere uma chave JSON
# 3. Compartilhe sua planilha com o e-mail da conta de serviço, como Editor
# 4. Preencha as linhas abaixo e troque o ENABLED para true
# --------------------------------------------------------------------------
GOOGLE_SHEETS_ENABLED=false
# GOOGLE_SHEETS_ID=              # o código que aparece na URL da planilha
# GOOGLE_SHEETS_TAB=Movimentacoes
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=""          # a private_key do JSON, entre aspas, com os \n
