// Controle Rafa Multimarcas — banco de dados
// Uma única variável de ambiente: DATABASE_URL

generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" é o runtime das funções serverless da Vercel.
  // "native" = sua máquina. "rhel-openssl-3.0.x" = servidor da Vercel
  // (Node 22, fixado no package.json). Sem ele, a API não fala com o banco.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GERENTE
  VENDEDOR
}

enum ProductStatus {
  EM_ESTOQUE
  RESERVADO
  VENDIDO
}

enum MovementType {
  ENTRADA
  SAIDA
  TRANSFERENCIA
  AJUSTE
}

/// Por que o estoque se mexeu. Fica separado do tipo porque uma saída pode
/// ser venda, perda, defeito… e o relatório precisa distinguir.
enum MovementReason {
  COMPRA
  CADASTRO
  VENDA
  DEFEITO
  DEVOLUCAO_FORNECEDOR
  PERDA
  USO_INTERNO
  AJUSTE
  TRANSFERENCIA
  CANCELAMENTO
  EXCLUSAO
  OUTRO
}

enum TransferStatus {
  PENDENTE
  EM_TRANSITO
  RECEBIDA
  CANCELADA
}

enum PaymentMethod {
  PIX
  DINHEIRO
  DEBITO
  CREDITO
  TRANSFERENCIA
}

/// Matriz, Sede… Cada uma tem seu estoque, que nunca se mistura.
model Unit {
  id        String   @id @default(uuid())
  name      String   @unique
  /// MATRIZ ou FILIAL — só para exibição e ordenação.
  type      String   @default("FILIAL")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock        Stock[]
  movements    StockMovement[]
  sales        Sale[]
  users        User[]
  transfersOut StockTransfer[] @relation("origem")
  transfersIn  StockTransfer[] @relation("destino")

  @@map("units")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(VENDEDOR)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Gerente e Vendedor enxergam só esta unidade. Administrador vê todas.
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  movements StockMovement[]
  sales     Sale[]
  auditLogs AuditLog[]

  @@index([unitId])
  @@map("users")
}

model Category {
  id     String  @id @default(uuid())
  name   String  @unique
  slug   String  @unique
  color  String?
  /// Quais campos aparecem no formulário desta categoria.
  /// Editável em Configurações → Categorias.
  campos Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  document  String?
  address   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([name])
  @@map("suppliers")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  document  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Product {
  id           String        @id @default(uuid())
  name         String
  brand        String?
  model        String?
  color        String?
  capacity     String?
  lote         String?
  /// Estoque mínimo por unidade — abaixo disso entra no alerta.
  minQuantity  Int           @default(1)
  costPrice    Decimal       @default(0) @db.Decimal(12, 2)
  salePrice    Decimal       @default(0) @db.Decimal(12, 2)
  imei         String?
  serialNumber String?
  barcode      String?
  notes        String?
  status       ProductStatus @default(EM_ESTOQUE)
  entryDate    DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// A quantidade vive aqui, uma linha por unidade. Nunca no produto:
  /// misturar os estoques da Matriz e da Sede seria o mesmo que não tê-los
  /// separados.
  stock     Stock[]
  photos    ProductPhoto[]
  sales     Sale[]
  movements StockMovement[]
  transfers StockTransfer[]

  @@index([name])
  @@index([brand])
  @@index([model])
  @@index([imei])
  @@index([serialNumber])
  @@index([lote])
  @@index([status])
  @@index([categoryId])
  @@index([supplierId])
  @@map("products")
}

/// A imagem fica no próprio banco — evita configurar serviço de arquivos.
/// O navegador reduz a foto antes de enviar, então cada linha é pequena.
model ProductPhoto {
  id        String   @id @default(uuid())
  data      Bytes
  mimeType  String   @default("image/jpeg")
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_photos")
}

model Sale {
  id            String        @id @default(uuid())
  quantity      Int
  unitPrice     Decimal       @db.Decimal(12, 2)
  totalPrice    Decimal       @db.Decimal(12, 2)
  costAtSale    Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  saleDate      DateTime      @default(now())
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Cópia dos dados do cliente no momento da venda
  customerName  String?
  customerPhone String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// De qual unidade o produto saiu. Obrigatório: sem isso não dá para
  /// saber quanto cada loja vendeu.
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  movements StockMovement[]

  @@index([unitId])
  @@index([saleDate])
  @@index([productId])
  @@index([customerId])
  @@map("sales")
}

/// Saldo de um produto numa unidade. É a fonte da verdade do estoque.
model Stock {
  id        String   @id @default(uuid())
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([productId, unitId])
  @@index([unitId])
  @@map("stock")
}

/// Histórico de tudo que mexeu no estoque. Nunca é apagado: corrigir é
/// lançar uma movimentação de ajuste, não editar o passado.
model StockMovement {
  id       String         @id @default(uuid())
  type     MovementType
  reason   MovementReason @default(OUTRO)
  quantity Int

  /// Saldo da unidade antes e depois — permite auditar sem recalcular tudo.
  previousQuantity Int?
  newQuantity      Int?

  notes     String?
  createdAt DateTime @default(now())

  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Guardado em texto para o histórico sobreviver à exclusão do produto.
  productName String?

  /// Unidade afetada por esta linha.
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  /// Preenchidos nas transferências.
  originUnitId      String?
  destinationUnitId String?

  /// Venda ou transferência que originou o movimento.
  referenceId String?

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  transferId String?
  transfer   StockTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type])
  @@index([productId])
  @@index([unitId])
  @@map("stock_movements")
}

/// Transferência entre unidades. Gera sempre duas movimentações ligadas:
/// a saída da origem e a entrada no destino.
model StockTransfer {
  id       String         @id @default(uuid())
  quantity Int
  status   TransferStatus @default(RECEBIDA)
  notes    String?

  createdAt  DateTime  @default(now())
  receivedAt DateTime?

  productId String
  product   Product @relation(fields: [productId], references: [id])

  originUnitId String
  originUnit   Unit   @relation("origem", fields: [originUnitId], references: [id])

  destinationUnitId String
  destinationUnit   Unit   @relation("destino", fields: [destinationUnitId], references: [id])

  requestedById String?
  receivedById  String?

  movements StockMovement[]

  @@index([createdAt])
  @@index([status])
  @@map("stock_transfers")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ip        String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity])
  @@map("audit_logs")
}

/// Chave/valor interno — guarda, entre outras coisas, o segredo do login
/// gerado automaticamente na primeira execução.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}
