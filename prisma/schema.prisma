// Controle Rafa Multimarcas — banco de dados
// Uma única variável de ambiente: DATABASE_URL

generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" é o runtime das funções serverless da Vercel.
  // "native" = sua máquina. "rhel-openssl-3.0.x" = servidor da Vercel
  // (Node 22, fixado no package.json). Sem ele, a API não fala com o banco.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GERENTE
  /// Opera o PDV: recebe pré-vendas, cobra e finaliza. Não mexe em cadastro.
  CAIXA
  /// Monta pré-vendas. Nunca dá baixa em estoque nem finaliza venda.
  VENDEDOR
}

/// Situação de uma pré-venda, do vendedor até o caixa.
enum PreSaleStatus {
  AGUARDANDO_CAIXA
  EM_ATENDIMENTO
  FINALIZADA
  CANCELADA
  EXPIRADA
}

enum SaleStatus {
  FINALIZADA
  CANCELADA
}

enum CashRegisterStatus {
  ABERTO
  FECHADO
}

enum ProductStatus {
  EM_ESTOQUE
  RESERVADO
  VENDIDO
}

enum MovementType {
  ENTRADA
  SAIDA
  TRANSFERENCIA
  AJUSTE
}

/// Por que o estoque se mexeu. Fica separado do tipo porque uma saída pode
/// ser venda, perda, defeito… e o relatório precisa distinguir.
enum MovementReason {
  COMPRA
  CADASTRO
  VENDA
  DEFEITO
  DEVOLUCAO_FORNECEDOR
  PERDA
  USO_INTERNO
  AJUSTE
  TRANSFERENCIA
  RETIRADA
  CANCELAMENTO
  EXCLUSAO
  OUTRO
}

/// Situação de uma retirada para a loja.
enum WithdrawalStatus {
  PENDENTE
  APROVADA
  CANCELADA
}

enum TransferStatus {
  PENDENTE
  EM_TRANSITO
  RECEBIDA
  CANCELADA
}

enum ImeiSituacao {
  NAO_CONSULTADO
  REGULAR
  IRREGULAR
  BLOQUEADO
}

enum TradeInStatus {
  /// Avaliada pelo vendedor, ainda não passou pelo caixa.
  AVALIADA
  /// Virou venda: o aparelho é da loja.
  ACEITA
  RECUSADA
}

enum TradeInFotoTipo {
  /// Print da consulta da Anatel.
  ANATEL
  /// Documento com foto do cliente.
  DOCUMENTO
  /// O aparelho, para registrar o estado em que chegou.
  APARELHO
}

enum PaymentMethod {
  PIX
  DINHEIRO
  DEBITO
  CREDITO
  TRANSFERENCIA
  /// Aparelho recebido na troca. Não é dinheiro na gaveta — o caixa nunca
  /// escolhe esta forma à mão; ela entra sozinha quando há troca.
  TROCA
  /// Fiado: o cliente levou e vai pagar depois. Também não é dinheiro na
  /// gaveta — vira uma cobrança em aberto até alguém dar baixa.
  EM_ABERTO
  OUTRO
}

/// Matriz, Sede… Cada uma tem seu estoque, que nunca se mistura.
model Unit {
  id        String   @id @default(uuid())
  name      String   @unique
  /// MATRIZ ou FILIAL — só para exibição e ordenação.
  type      String   @default("FILIAL")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock        Stock[]
  movements    StockMovement[]
  sales        Sale[]
  users        User[]
  transfersOut StockTransfer[]   @relation("origem")
  transfersIn  StockTransfer[]   @relation("destino")
  withdrawals  StockWithdrawal[]
  tradeIns     TradeIn[]
  PreSale      PreSale[]
  CashRegister CashRegister[]

  @@map("units")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(VENDEDOR)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Gerente e Vendedor enxergam só esta unidade. Administrador vê todas.
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  /// Foto de perfil. Guardada aqui e não num arquivo à parte porque é uma
  /// por pessoa e some junto com a conta — não vale uma tabela.
  foto         Bytes?
  fotoMimeType String?

  movements StockMovement[]
  auditLogs AuditLog[]

  vendasComoVendedor Sale[]         @relation("vendedor")
  vendasComoCaixa    Sale[]         @relation("caixa")
  preVendasCriadas   PreSale[]      @relation("vendedorPreVenda")
  preVendasAtendidas PreSale[]      @relation("caixaPreVenda")
  turnosDeCaixa      CashRegister[] @relation("turnoDoCaixa")
  notificacoes       Notification[]
  tradeIns           TradeIn[]      @relation("vendedorTroca")

  @@index([unitId])
  @@map("users")
}

model Category {
  id     String  @id @default(uuid())
  name   String  @unique
  slug   String  @unique
  color  String?
  /// Quais campos aparecem no formulário desta categoria.
  /// Editável em Configurações → Categorias. A subcategoria herda os do
  /// pai quando não define os seus.
  campos Json?

  /// Subcategoria: "Celulares › Vitrine". Um nível só — dois já viram
  /// labirinto para quem cadastra com o cliente esperando.
  parentId String?
  parent   Category?  @relation("subcategorias", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("subcategorias")

  /// Ordem de exibição entre irmãs. Menor primeiro.
  ordem Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  document  String?
  address   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([name])
  @@map("suppliers")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  document  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales    Sale[]
  tradeIns TradeIn[]
  PreSale  PreSale[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Product {
  id               String        @id @default(uuid())
  name             String
  brand            String?
  model            String?
  color            String?
  capacity         String?
  lote             String?
  /// Estado do aparelho: Lacrado, Vitrine, Seminovo…
  condicao         String?
  /// Estoque mínimo por unidade — abaixo disso entra no alerta.
  minQuantity      Int           @default(1)
  /// Custo médio ponderado. Recalculado a cada entrada de mercadoria — é
  /// ele que vale para margem e valor do estoque, e não a última nota.
  costPrice        Decimal       @default(0) @db.Decimal(12, 2)
  /// Quanto foi pago na compra mais recente. Serve para comparar, não para
  /// calcular: substituir o custo pela última nota distorce a margem.
  lastPurchaseCost Decimal?      @db.Decimal(12, 2)
  /// Quando a última compra entrou.
  lastPurchaseAt   DateTime?
  salePrice        Decimal       @default(0) @db.Decimal(12, 2)
  /// Preço para atacado. Vazio = o produto só é vendido no varejo.
  wholesalePrice   Decimal?      @db.Decimal(12, 2)
  /// Aparelho usado que a loja recebeu — de troca ou comprado direto.
  /// Continua sendo estoque normal; a marca só o faz aparecer na aba.
  seminovo         Boolean       @default(false)
  /// Quanto a loja pagou pelo usado, quando veio de compra direta. Na
  /// troca é o valor avaliado, e ele já vira o custo.
  seminovoOrigem   String?

  imei             String?
  serialNumber     String?
  barcode          String?
  notes            String?
  status           ProductStatus @default(EM_ESTOQUE)
  entryDate        DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  /// A peça da troca que virou este produto. Única: impede cadastrar o
  /// mesmo aparelho duas vezes se a venda for corrigida.
  tradeInAparelhoId String?          @unique
  tradeInAparelho   TradeInAparelho? @relation(fields: [tradeInAparelhoId], references: [id], onDelete: SetNull)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// A quantidade vive aqui, uma linha por unidade. Nunca no produto:
  /// misturar os estoques da Matriz e da Sede seria o mesmo que não tê-los
  /// separados.
  stock        Stock[]
  photos       ProductPhoto[]
  tradeIns     TradeIn[]
  saleItems    SaleItem[]
  preSaleItems PreSaleItem[]
  movements    StockMovement[]
  transfers    StockTransfer[]
  withdrawals  StockWithdrawal[]

  @@index([name])
  @@index([brand])
  @@index([model])
  @@index([imei])
  @@index([serialNumber])
  @@index([lote])
  @@index([condicao])
  @@index([status])
  @@index([categoryId])
  @@index([supplierId])
  @@map("products")
}

/// A imagem fica no próprio banco — evita configurar serviço de arquivos.
/// O navegador reduz a foto antes de enviar, então cada linha é pequena.
/// Aparelho usado recebido como parte do pagamento.
model TradeIn {
  id     String        @id @default(uuid())
  /// Número visível: TR-000001.
  code   String        @unique
  status TradeInStatus @default(AVALIADA)

  // ----- o aparelho que entra
  modelo        String
  marca         String?
  armazenamento String?
  cor           String?
  /// Opcional: no balcão a caixa anota só modelo, cor e capacidade, e o
  /// cadastro completo fica para quando o aparelho for para a prateleira.
  imei          String?
  imeiSituacao  ImeiSituacao @default(NAO_CONSULTADO)
  /// Quando a consulta da Anatel foi feita.
  imeiCheckedAt DateTime?

  estado      String?
  /// Chaves de shared/trocas.ts — bateria, tela, traseira…
  defeitos    String[]
  observacoes String?

  /// Quanto a loja aceitou pagar pelo aparelho usado.
  valorAvaliado Decimal @db.Decimal(12, 2)

  // ----- o aparelho que sai
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  saidaNome  String?
  valorSaida Decimal  @default(0) @db.Decimal(12, 2)

  // ----- o cliente
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String
  customerPhone    String?
  customerDocument String?

  aparelhos TradeInAparelho[]

  sellerId String
  seller   User   @relation("vendedorTroca", fields: [sellerId], references: [id])

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  preSaleId String?  @unique
  preSale   PreSale? @relation(fields: [preSaleId], references: [id], onDelete: SetNull)

  saleId String? @unique
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  /// Produto criado no estoque quando a troca foi aceita.
  estoqueProductId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos TradeInPhoto[]

  @@index([status])
  @@index([sellerId])
  @@index([imei])
  @@index([createdAt])
  @@map("trade_ins")
}

/// Cada aparelho que o cliente deixou na troca.
///
/// O cliente às vezes entrega dois ou três de uma vez, e cada um tem IMEI,
/// estado e avaliação próprios. O total da troca é a soma deles — é isso
/// que abate do que ele tem a pagar.
model TradeInAparelho {
  id String @id @default(uuid())

  modelo        String
  marca         String?
  armazenamento String?
  cor           String?
  imei          String?
  imeiSituacao  ImeiSituacao @default(NAO_CONSULTADO)
  imeiCheckedAt DateTime?

  estado      String?
  /// Chaves de shared/trocas.ts — bateria, tela, traseira…
  defeitos    String[]
  observacoes String?

  /// Quanto a loja aceitou pagar por este aparelho.
  valorAvaliado Decimal @db.Decimal(12, 2)

  /// Ordem em que foram anotados, para a tela não embaralhar.
  ordem Int @default(0)

  tradeInId String
  tradeIn   TradeIn @relation(fields: [tradeInId], references: [id], onDelete: Cascade)

  fotos TradeInPhoto[]

  /// O produto de estoque criado a partir deste aparelho.
  produto Product?

  @@index([tradeInId])
  @@map("trade_in_aparelhos")
}

model TradeInPhoto {
  id        String          @id @default(uuid())
  tipo      TradeInFotoTipo @default(APARELHO)
  data      Bytes
  mimeType  String          @default("image/jpeg")
  createdAt DateTime        @default(now())

  tradeInId String
  tradeIn   TradeIn @relation(fields: [tradeInId], references: [id], onDelete: Cascade)

  /// De qual aparelho é a foto. Vazio = documento do cliente, que é da
  /// troca inteira e não de uma peça.
  aparelhoId String?
  aparelho   TradeInAparelho? @relation(fields: [aparelhoId], references: [id], onDelete: Cascade)

  @@index([tradeInId])
  @@index([aparelhoId])
  @@map("trade_in_photos")
}

model ProductPhoto {
  id        String   @id @default(uuid())
  data      Bytes
  mimeType  String   @default("image/jpeg")
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_photos")
}

/// Venda concluída. Só o caixa cria — é aqui que o estoque baixa.
model Sale {
  id     String     @id @default(uuid())
  /// Número visível: VD-000001.
  code   String     @unique
  status SaleStatus @default(FINALIZADA)

  /// Somas dos itens, guardadas aqui para os relatórios não precisarem
  /// recalcular a cada consulta.
  totalAmount Decimal @db.Decimal(12, 2)
  costAmount  Decimal @default(0) @db.Decimal(12, 2)
  /// Quanto foi cobrado além do preço dos produtos — o repasse da taxa do
  /// cartão. Fica separado para o relatório não confundir preço com taxa.
  surcharge   Decimal @default(0) @db.Decimal(12, 2)

  paymentMethod PaymentMethod
  /// 1 = à vista.
  installments  Int           @default(1)

  saleDate  DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Quando veio de uma pré-venda.
  preSaleId String?  @unique
  preSale   PreSale? @relation(fields: [preSaleId], references: [id], onDelete: SetNull)

  /// Quem vendeu (para comissão) e quem recebeu (caixa).
  sellerId   String?
  seller     User?   @relation("vendedor", fields: [sellerId], references: [id], onDelete: SetNull)
  /// Nome digitado no balcão, para quem vende mas não tem login.
  sellerName String?
  cashierId  String?
  cashier    User?   @relation("caixa", fields: [cashierId], references: [id], onDelete: SetNull)

  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Cópia dos dados do cliente no momento da venda
  customerName     String?
  customerPhone    String?
  customerDocument String?

  /// De qual unidade o produto saiu.
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  /// Estrutura pronta para comissão; ainda não usada nos cálculos.
  commissionRate   Decimal? @db.Decimal(5, 2)
  commissionAmount Decimal? @db.Decimal(12, 2)

  items     SaleItem[]
  payments  SalePayment[]
  tradeIn   TradeIn?
  movements StockMovement[]

  @@index([unitId])
  @@index([saleDate])
  @@index([customerId])
  @@index([sellerId])
  @@index([cashierId])
  @@map("sales")
}

/// Cada produto dentro de uma venda.
/// Uma das formas de pagamento de uma venda.
///
/// Existe sempre — inclusive quando a venda tem forma única. Assim o
/// fechamento do caixa soma por aqui e nunca precisa decidir se olha a
/// venda ou o rateio.
model SalePayment {
  id           String        @id @default(uuid())
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  installments Int           @default(1)

  /// Taxa da maquininha nesta parcela, em %. Só no crédito.
  feePercent Decimal? @db.Decimal(6, 2)
  /// O que sobra depois do desconto da maquininha — é o que cai na conta.
  netAmount  Decimal? @db.Decimal(12, 2)

  /// Quando o fiado foi quitado. Vazio = ainda em aberto.
  settledAt     DateTime?
  /// Como o cliente acertou a dívida.
  settledMethod PaymentMethod?
  /// Quem deu a baixa.
  settledById   String?
  /// Bandeira, número da maquininha, quem transferiu…
  notes         String?
  /// Para onde o dinheiro foi: qual conta de Pix, por exemplo. Guardado
  /// como texto para o histórico sobreviver a uma conta encerrada.
  destino       String?

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([method])
  @@map("sale_payments")
}

model SaleItem {
  id       String @id @default(uuid())
  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)
  /// Custo no momento da venda: o lucro histórico não muda depois.
  costPrice Decimal @default(0) @db.Decimal(12, 2)

  /// Identificação da peça vendida. É por aqui que se impede vender o
  /// mesmo aparelho duas vezes.
  imei         String?
  serialNumber String?

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId   String
  product     Product @relation(fields: [productId], references: [id])
  /// Nome no momento da venda, para o histórico não depender do cadastro.
  productName String?

  commissionAmount Decimal? @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
  @@index([imei])
  @@index([serialNumber])
  @@map("sale_items")
}

/// Intenção de venda montada pelo vendedor. NÃO mexe no estoque.
model PreSale {
  id     String        @id @default(uuid())
  /// Número visível: PV-000001.
  code   String        @unique
  status PreSaleStatus @default(AGUARDANDO_CAIXA)

  totalAmount   Decimal        @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod?
  installments  Int            @default(1)
  notes         String?

  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String
  customerPhone    String?
  customerDocument String?

  sellerId String
  seller   User   @relation("vendedorPreVenda", fields: [sellerId], references: [id])

  /// Caixa que assumiu o atendimento.
  cashierId String?
  cashier   User?   @relation("caixaPreVenda", fields: [cashierId], references: [id], onDelete: SetNull)

  /// Unidade sugerida pelo vendedor; o caixa confirma na finalização.
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Depois disso a pré-venda vira EXPIRADA.
  expiresAt DateTime?

  items   PreSaleItem[]
  sale    Sale?
  /// Aparelho usado dado como parte do pagamento.
  tradeIn TradeIn?

  @@index([status])
  @@index([sellerId])
  @@index([createdAt])
  @@map("pre_sales")
}

model PreSaleItem {
  id       String @id @default(uuid())
  quantity Int

  unitPrice    Decimal @db.Decimal(12, 2)
  imei         String?
  serialNumber String?

  preSaleId String
  preSale   PreSale @relation(fields: [preSaleId], references: [id], onDelete: Cascade)

  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String?

  @@index([preSaleId])
  @@index([productId])
  @@map("pre_sale_items")
}

/// Turno do caixa: abertura, vendas do período e fechamento.
model CashRegister {
  id     String             @id @default(uuid())
  code   String             @unique
  status CashRegisterStatus @default(ABERTO)

  cashierId String
  cashier   User   @relation("turnoDoCaixa", fields: [cashierId], references: [id])

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  openedAt DateTime  @default(now())
  closedAt DateTime?

  /// Resumo congelado no fechamento (totais por forma de pagamento).
  summary Json?
  notes   String?

  sales Sale[]

  @@index([cashierId])
  @@index([status])
  @@map("cash_registers")
}

/// Aviso na tela para um usuário específico.
model Notification {
  id      String  @id @default(uuid())
  title   String
  message String
  /// Para onde a notificação leva ao ser clicada.
  link    String?
  read    Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

/// Contador para os números visíveis (PV-000001, VD-000001).
model Sequence {
  name  String @id
  value Int    @default(0)

  @@map("sequences")
}

/// Saldo de um produto numa unidade. É a fonte da verdade do estoque.
model Stock {
  id        String   @id @default(uuid())
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([productId, unitId])
  @@index([unitId])
  @@map("stock")
}

/// Histórico de tudo que mexeu no estoque. Nunca é apagado: corrigir é
/// lançar uma movimentação de ajuste, não editar o passado.
model StockMovement {
  id       String         @id @default(uuid())
  type     MovementType
  reason   MovementReason @default(OUTRO)
  quantity Int

  /// Saldo da unidade antes e depois — permite auditar sem recalcular tudo.
  previousQuantity Int?
  newQuantity      Int?

  /// Numa entrada: quanto foi pago por unidade nesta nota.
  unitCost         Decimal? @db.Decimal(12, 2)
  /// Custo médio do produto depois desta entrada, para auditar o cálculo.
  averageCostAfter Decimal? @db.Decimal(12, 2)

  notes     String?
  createdAt DateTime @default(now())

  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Guardado em texto para o histórico sobreviver à exclusão do produto.
  productName String?

  /// Unidade afetada por esta linha.
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  /// Preenchidos nas transferências.
  originUnitId      String?
  destinationUnitId String?

  /// Venda ou transferência que originou o movimento.
  referenceId String?

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  transferId String?
  transfer   StockTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)

  withdrawalId String?
  withdrawal   StockWithdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type])
  @@index([productId])
  @@index([unitId])
  @@map("stock_movements")
}

/// Retirada do estoque para a loja.
///
/// Enquanto está pendente o saldo NÃO diminui — mas fica reservado, para
/// ninguém vender duas vezes a mesma peça. No fim do dia você aprova
/// informando quanto realmente saiu; o que sobrou continua no estoque,
/// porque nunca chegou a sair.
model StockWithdrawal {
  id               String           @id @default(uuid())
  /// Quanto foi levado para a loja.
  quantity         Int
  /// Quanto realmente saiu, informado na aprovação.
  soldQuantity     Int?
  /// O que voltou (quantity - soldQuantity), guardado para o histórico.
  returnedQuantity Int?
  status           WithdrawalStatus @default(PENDENTE)
  notes            String?

  createdAt  DateTime  @default(now())
  approvedAt DateTime?

  productId String
  product   Product @relation(fields: [productId], references: [id])

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  requestedById String?
  approvedById  String?

  movements StockMovement[]

  @@index([status])
  @@index([productId, unitId])
  @@map("stock_withdrawals")
}

/// Transferência entre unidades. Gera sempre duas movimentações ligadas:
/// a saída da origem e a entrada no destino.
model StockTransfer {
  id       String         @id @default(uuid())
  quantity Int
  status   TransferStatus @default(RECEBIDA)
  notes    String?

  createdAt  DateTime  @default(now())
  receivedAt DateTime?

  productId String
  product   Product @relation(fields: [productId], references: [id])

  originUnitId String
  originUnit   Unit   @relation("origem", fields: [originUnitId], references: [id])

  destinationUnitId String
  destinationUnit   Unit   @relation("destino", fields: [destinationUnitId], references: [id])

  requestedById String?
  receivedById  String?

  movements StockMovement[]

  @@index([createdAt])
  @@index([status])
  @@map("stock_transfers")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ip        String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity])
  @@map("audit_logs")
}

/// Chave/valor interno — guarda, entre outras coisas, o segredo do login
/// gerado automaticamente na primeira execução.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}
